# Supabase — copy this file to .env.local and fill in your project values.
# Leave both empty to run the app in local demo mode (data stays in this browser).
#
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenRouter — powers the 「自动填写」 (Auto-fill with AI) button in the chef's
# wish inbox. Server-side only: no NEXT_PUBLIC_ prefix, so the key never reaches
# the browser. Leave it empty and the button simply asks you to fill in by hand.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: any OpenRouter model that can read images.
# Defaults to openai/gpt-4o-mini. deepseek/deepseek-chat works for text only.
OPENROUTER_MODEL=

# Unsplash — powers the 「✨ 自动找图」 button on the dish form.
# Server-side only. Create a free app at https://unsplash.com/developers and
# copy the Access Key. Leave it empty to keep manual photo upload only.
UNSPLASH_ACCESS_KEY=
